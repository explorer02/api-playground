{
  "name": "@explorer02/api-playground",
  "version": "2.0.1",
  "description": "API Playground component",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles/*": {
      "source": "./src/styles/*",
      "default": "./dist/styles/*"
    },
    "./dist/styles/index.css": "./dist/styles/index.css",
    "./styles.css": "./dist/styles/tailwind.css",
    "./root.css": "./dist/styles/root.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node ./scripts/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/explorer02/api-playground.git"
  },
  "keywords": [
    "api-playground",
    "playground",
    "api"
  ],
  "author": "Ajay Bhardwaj",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/explorer02/api-playground/issues"
  },
  "homepage": "https://github.com/explorer02/api-playground#readme",
  "dependencies": {
    "@monaco-editor/react": "^4.5.1",
    "react-icons": "4.10.1",
    "react-use": "^12.2.0",
    "rtl-css-js": "^1.16.1"
  },
  "peerDependencies": {
    "@apollo/client": ">=3.8.0",
    "@types/react": ">=18.0.0",
    "@types/react-dom": ">=18.0.0",
    "graphql": ">=16.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "purgecss": "^5.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "resolve-tspaths": "^0.8.23",
    "sass": "^1.70.0",
    "tsup": "^8.0.0",
    "typescript": ">=5.9.2"
  }
}
